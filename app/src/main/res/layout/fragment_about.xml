<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  Company:       Vesta
  File:          fragment_about.xml
  Layer:         Resources / Layout (Acerca De)
  ============================================================================

  DESCRIPCIÓN:
  Pantalla institucional e informativa. Despliega logotipo de la empresa,
  versión del software, derechos reservados y descripción de la plataforma.

  ARCHIVOS RELACIONADOS:
  - AboutFragment.java         -> Controlador del fragmento.
  - ConfiguracionFragment.java -> Pantalla previa en flujo.
  ============================================================================
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="@color/background_app">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/img_logo"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VESTA"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Versión 1.0"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Desarrollado para facilitar la gestión y búsqueda de propiedades inmobiliarias."
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="© 2026 VESTA Inc."
        android:textSize="12sp"
        android:textColor="@color/text_muted"/>

</LinearLayout>
