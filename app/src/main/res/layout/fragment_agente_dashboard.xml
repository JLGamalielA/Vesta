<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  Company:       Vesta
  File:          fragment_agente_dashboard.xml
  Layer:         Resources / Layout (Dashboard Agente)
  ============================================================================

  DESCRIPCIÓN:
  Pantalla principal para agentes y clientes. Dispone buscador textual, selector
  de pestañas (Catálogo / Mis Propiedades), botón de filtros y lista con Pull-to-Refresh.

  ARCHIVOS RELACIONADOS:
  - AgenteDashboardFragment.java -> Controlador de la vista.
  - AgenteViewModel.java         -> Suministra datos observados.
  - item_inmueble.xml            -> Tarjeta de propiedad renderizada.
  ============================================================================
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <!-- CONTENEDOR DE BÚSQUEDA Y FILTROS -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <EditText
            android:id="@+id/etBuscarInmueble"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/selector_radio_button"
            android:backgroundTint="@color/surface_card"
            android:hint="Buscar por título o ubicación..."
            android:paddingHorizontal="16dp"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/gray_hint"
            android:textSize="14sp"
            android:inputType="text" />

        <ImageButton
            android:id="@+id/btnFiltros"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="@color/blue_primary"
            android:contentDescription="Filtrar propiedades" />
    </LinearLayout>

    <!-- MENSAJE DE ESTADO VACÍO -->
    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No hay propiedades con estos filtros."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/searchContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- PULL-TO-REFRESH ENVOLVIENDO EL RECYCLERVIEW -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshAgente"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/searchContainer"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewInmuebles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="80dp"
            tools:listitem="@layout/item_inmueble" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:indeterminateTint="@color/blue_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
