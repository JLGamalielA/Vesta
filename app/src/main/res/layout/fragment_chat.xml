<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  Company:       Vesta
  File:          fragment_chat.xml
  Layer:         Resources / Layout (Mensajería - Conversación)
  ============================================================================

  DESCRIPCIÓN:
  Pantalla de mensajería instantánea. Despliega historial de mensajes en
  RecyclerView vertical y barra inferior para escritura y envío.

  ARCHIVOS RELACIONADOS:
  - ConversacionFragment.java -> Controlador de la conversación.
  - ChatViewModel.java        -> Orquesta mensajes en tiempo-real.
  - item_message.xml          -> Burbuja individual de mensaje.
  ============================================================================
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_app">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarChat"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/blue_primary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:paddingBottom="90dp"
        android:clipToPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:layout_marginBottom="80dp"
        android:background="@color/surface_variant">

        <EditText
            android:id="@+id/etMessageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Escribe un mensaje..."
            android:textColor="@color/text_primary"
            android:textColorHint="@color/gray_hint"
            android:background="@color/surface_card"
            android:padding="12dp"
            android:layout_marginEnd="8dp"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"/>

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_send"
            android:contentDescription="Enviar" />
    </LinearLayout>
</LinearLayout>
