<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  Company:       Vesta
  File:          nav_header_main.xml
  Layer:         Resources / Layout (Cabecera Menú Lateral)
  ============================================================================

  DESCRIPCIÓN:
  Cabecera visual para el menú lateral (Navigation Drawer). Muestra avatar,
  nombre y correo del usuario activo.

  ARCHIVOS RELACIONADOS:
  - MainActivity.java          -> Vincula cabecera con NavigationView.
  - activity_main_drawer_*.xml -> Menús asociados a cabecera.
  ============================================================================
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="176dp"
    android:background="@color/blue_primary"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="16dp"
    android:theme="@style/ThemeOverlay.AppCompat.Dark">

    <ImageView
        android:id="@+id/ivHeaderIcon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="Logo"
        android:src="@drawable/img_logo"
        android:background="@drawable/circle_white"
        android:padding="12dp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textStyle="bold"
        android:textColor="@color/white"/>

    <TextView
        android:id="@+id/tvHeaderSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bienvenido"
        android:textColor="@color/border_light"
        android:textSize="14sp"/>

</LinearLayout>