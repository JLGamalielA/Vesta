<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  Company:       Vesta
  File:          themes.xml (values-night)
  Layer:         Resources / Theme (Modo Oscuro)
  ============================================================================

  DESCRIPCIÓN:
  Tema para Modo Oscuro. Configura contraste para fondos oscuros
  e invierte los indicadores de la barra de estado para legibilidad nocturna.

  ARCHIVOS RELACIONADOS:
  - values-night/colors.xml  -> Suministra paleta oscura.
  - values/themes.xml        -> Equivalente en modo claro.
  ============================================================================
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Vesta" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores Primarios y Marca Modo Oscuro -->
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/blue_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/blue_primary</item>

        <!-- Fondos y Superficies Pizarra -->
        <item name="android:colorBackground">@color/background_app</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Barra de Estado y Navegación del Sistema (Iconos blancos en barra oscura) -->
        <item name="android:statusBarColor">@color/surface_card</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/surface_card</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.Vesta" parent="Base.Theme.Vesta" />
</resources>